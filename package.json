{
  "name": "bun-template",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "bun --watch ./src/app.ts",
    "build": "bun build ./src/app.ts --outdir ./dist",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "hono": "4.12.10"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/bun": "1.3.11",
    "eslint": "9.39.4",
    "eslint-plugin-perfectionist": "5.8.0",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0"
  }
}
